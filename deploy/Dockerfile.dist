# syntax=docker/dockerfile:1.7
# 42ctl distribution image (P6, D11). FROM scratch + the RELEASED static musl binary for
# the target arch, fetched from the GitHub Release and SHA-256-verified against its
# SHA256SUMS inside the build — the image ships exactly the bytes the release attested,
# with no second compile (and no QEMU-emulated Rust build for arm64). Non-root, CA bundle
# only. Built multi-arch by docker.yml with `--build-arg VERSION=vX.Y.Z`.
#
# The repo-root Dockerfile remains the from-source reproducible build proven in ci.yml.

FROM --platform=$BUILDPLATFORM alpine:3 AS fetch
ARG TARGETARCH
ARG VERSION
RUN apk add --no-cache curl ca-certificates
RUN set -eu; \
    case "${TARGETARCH}" in \
      amd64) t=x86_64 ;; \
      arm64) t=aarch64 ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    asset="42ctl-${t}-unknown-linux-musl"; \
    base="https://github.com/Univers42/42ctl/releases/download/${VERSION}"; \
    curl -fsSL -o /42ctl "${base}/${asset}"; \
    curl -fsSL -o /SHA256SUMS "${base}/SHA256SUMS"; \
    grep " ${asset}\$" /SHA256SUMS | sed "s| ${asset}\$|  /42ctl|" | sha256sum -c -; \
    chmod 0755 /42ctl

FROM scratch AS runtime
COPY --from=fetch /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=fetch /42ctl /42ctl

# Non-root, read-only-friendly: the static binary owns no writable paths.
USER 65532:65532
ENTRYPOINT ["/42ctl"]
